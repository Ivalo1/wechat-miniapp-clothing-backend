# ========================================
# 环境变量配置 (生产环境请修改此处配置)
# ========================================

# 数据库
DB_PASSWORD=postgres123

# Redis
REDIS_PASSWORD=redis123

# JWT
JWT_SECRET=your-256-bit-secret-key-for-jwt-token-signing-change-in-production

# 微信小程序
WX_APPID=your-appid
WX_SECRET=your-secret

# 微信支付
WX_PAY_APPID=your-appid
WX_MCH_ID=your-mch-id
WX_MCH_KEY=your-mch-key
WX_NOTIFY_URL=https://your-domain.com/api/mini/pay/notify

# 阿里云 OSS
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY=your-access-key
ALIYUN_OSS_SECRET_KEY=your-secret-key
ALIYUN_OSS_BUCKET=your-bucket-name

# XXL-Job
XXL_JOB_TOKEN=

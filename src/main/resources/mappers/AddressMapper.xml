<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ivalo1.wechatbackend.mapper.AddressMapper">

  <resultMap id="AddressResult" type="com.ivalo1.wechatbackend.model.Address">
    <id property="id" column="id" />
    <result property="userId" column="user_id" />
    <result property="consignee" column="consignee" />
    <result property="phone" column="phone" />
    <result property="fullAddress" column="full_address" />
    <result property="isDefault" column="is_default" />
  </resultMap>

  <select id="findByUserId" parameterType="long" resultMap="AddressResult">
    SELECT id, user_id, consignee, phone, full_address, is_default FROM addresses WHERE user_id = #{userId} ORDER BY is_default DESC
  </select>

  <insert id="insert" parameterType="com.ivalo1.wechatbackend.model.Address" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO addresses(user_id, consignee, phone, full_address, is_default)
    VALUES(#{userId}, #{consignee}, #{phone}, #{fullAddress}, #{isDefault})
  </insert>

</mapper>
